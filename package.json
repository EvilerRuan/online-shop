{
  "name": "online-shop",
  "version": "1.0.0",
  "private": true,
  "description": "线上商城系统 - 批发端(H5) + 零售端(Taro小程序) + 管理后台(Admin)",
  "scripts": {
    "// 批发端 (B2B H5)": "",
    "dev:h5": "pnpm --filter h5 dev",
    "build:h5": "pnpm --filter h5 build",
    "// 零售端 (B2C Taro 微信小程序)": "",
    "dev:retail": "pnpm --filter retail-h5 dev:weapp",
    "build:retail": "pnpm --filter retail-h5 build:weapp",
    "// 管理后台 (Admin)": "",
    "dev:admin": "pnpm --filter admin dev",
    "build:admin": "pnpm --filter admin build",
    "// API 服务 (Cloudflare Workers)": "",
    "dev:api": "pnpm --filter api dev",
    "dev:api:local": "pnpm --filter api dev:local",
    "build:api": "pnpm --filter api build",
    "deploy:api": "pnpm --filter api run deploy",
    "// 其他": "",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
